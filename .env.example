# Shared
JWT_SECRET=change-me-in-production

# Hardhat / Blockchain
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_without_0x_prefix

# Backend
PORT=4000
MONGODB_URI=mongodb://localhost:27017/khetchain
USE_MEMORY_DB=false
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
KHETCHAIN_CONTRACT_ADDRESS=
RELAYER_PRIVATE_KEY=your_hardhat_account_0_private_key
FRONTEND_URL=http://localhost:5173

# Frontend (copy to frontend/.env)
VITE_API_URL=http://localhost:4000/api/v1
VITE_CONTRACT_ADDRESS=
VITE_CHAIN_ID=31337
