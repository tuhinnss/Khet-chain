# Shared
JWT_SECRET=change-me-in-production

# Hardhat / Blockchain
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_without_0x_prefix

# Backend
PORT=4000
MONGODB_URI=mongodb://localhost:27017/khetchain
USE_MEMORY_DB=false
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
KHETCHAIN_CONTRACT_ADDRESS=
# Backend key that grants/revokes roles when an admin approves a user. Use a
# separate, low-value key (NOT the deployer): deploy.ts gives it only
# REGISTRAR_ROLE. It needs a little ETH for gas. Locally, Hardhat account #9.
RELAYER_PRIVATE_KEY=your_relayer_private_key
# Comma-separated wallets allowed to register as platform admin (they approve
# new users). Locally, Hardhat account #0: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
ADMIN_WALLETS=
FRONTEND_URL=http://localhost:5173
# Optional: block to start the event listener's first sync from (defaults to
# ~10,000 blocks before the current tip). Set this to your contract's actual
# deployment block if you need to backfill further than the default window --
# note free public RPC nodes may reject very old ranges with "pruned history
# unavailable".
EVENT_SYNC_START_BLOCK=

# Frontend (copy to frontend/.env)
VITE_API_URL=http://localhost:4000/api/v1
VITE_CONTRACT_ADDRESS=
VITE_CHAIN_ID=31337
# For live Sepolia testnet instead of local Hardhat, use:
# VITE_CHAIN_ID=11155111
# VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# VITE_EXPLORER_URL=https://sepolia.etherscan.io
